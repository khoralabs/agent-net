# Reference app env (loaded when cwd is apps/reference, or copy values into your shell).
# Two-terminal flow: terminal 1 = `bun run start`; terminal 2 = `bun run marketplace`.
# After start, copy memories/relay/chat URLs from the orchestrator JSON if ports differ below.

# --- LLM (marketplace evaluate + swarm) ---
AI_GATEWAY_API_KEY=
# AGENT_DEFAULT_MODEL=zai/glm-5.2-fast

# --- Khora (start separately: cd khora/apps/server && bun run start) ---
KHORA_BASE_URL=http://127.0.0.1:8788
# KHORA_ADMIN_TOKEN=

# --- Local stack URLs (orchestrator defaults: relay 8790, memories 8791, chat 8792) ---
# Start orchestrator first: bun run start
MEMORIES_BASE_URL=http://127.0.0.1:8791
MEMORIES_SERVICE_ADMIN_TOKEN=reference-memories-admin-token
RELAY_BASE_URL=http://127.0.0.1:8790
CHAT_BASE_URL=http://127.0.0.1:8792
CHAT_INTERNAL_TOKEN=reference-chat-token

# --- Data dir (default apps/reference/.data via package.json scripts) ---
# HARNESS_SWARM_DATA_DIR=./.data
# HARNESS_AGENT_DATA_DIR=./.data

# --- Optional: memories SQLite extensions (macOS Homebrew) ---
# SQLITE_CUSTOM_LIB=/opt/homebrew/opt/sqlite/lib/libsqlite3.dylib
# SQLCIPHER_CUSTOM_LIB=/opt/homebrew/opt/sqlcipher/lib/libsqlcipher.dylib

# --- Optional: harness identity / Khora admin (multi-host or invite flows) ---
# HARNESS_IDENTITY_WRAP_KEY=

# --- Optional: Workflow Turso world (auto-set by configureTursoWorldEnv) ---
# WORKFLOW_TARGET_WORLD=@workflow-worlds/turso
# WORKFLOW_TURSO_DATABASE_URL=file:.data/workflow.db
# WORKFLOW_SERVICE_URL=http://localhost:3000

# --- Optional: logging ---
# LOG_LEVEL=info

# --- Alternate env key names (harness also accepts these) ---
# MEMORIES_SERVICE_URL=
# HARNESS_MEMORIES_BASE_URL=
# RELAY_SERVER_URL=
# HARNESS_RELAY_BASE_URL=
# CHAT_SERVICE_URL=
# HARNESS_CHAT_BASE_URL=
# KHORA_SERVER_URL=
# HARNESS_KHORA_BASE_URL=
