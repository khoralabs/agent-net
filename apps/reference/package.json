{
  "name": "@khoralabs/agent-net-reference",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./world/local": "./src/world/local.ts"
  },
  "scripts": {
    "start": "bun run src/orchestrator.ts -- --data-dir .data",
    "marketplace": "bun run src/run-marketplace.ts -- --data-dir .data",
    "swarm": "bun run src/run-swarm.ts -- --data-dir .data",
    "events": "bun run src/events-cli.ts -- --data-dir .data",
    "agent:setup": "bun -e \"import { mkdirSync } from 'node:fs'; mkdirSync('.data', { recursive: true })\"",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@khoralabs/agent-net": "workspace:*",
    "@khoralabs/chat": "catalog:",
    "@khoralabs/khora-client": "catalog:",
    "@khoralabs/khora-host": "catalog:",
    "@khoralabs/memories-node": "catalog:",
    "@khoralabs/memories-service": "catalog:",
    "@khoralabs/relay": "catalog:",
    "@khoralabs/sqlite-crypto": "catalog:",
    "@khoralabs/sqlite-migrate": "catalog:",
    "ai": "catalog:",
    "ajv": "^8",
    "pino": "^9.6.0",
    "sqlite-vec": "^0.1.10-alpha.4",
    "workflow": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "typescript": "catalog:"
  }
}
